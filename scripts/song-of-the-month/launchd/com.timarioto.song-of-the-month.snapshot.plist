<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.timarioto.song-of-the-month.snapshot</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/timarioto/Code/timarioto.com/scripts/song-of-the-month/snapshot.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>23</integer>
    <key>Minute</key>
    <integer>50</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/timarioto/Library/Logs/song-of-the-month/snapshot.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/timarioto/Library/Logs/song-of-the-month/snapshot.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
