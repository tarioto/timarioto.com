# See http://help.github.com/ignore-files/ for more about ignoring files.

# build output
/dist

# dependencies
/node_modules

# Yarn (Berry / PnP, non-zero-install)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# TypeScript incremental build info
*.tsbuildinfo

# TypeScript-emitted config artifacts (from `tsc -b`)
vite.config.js
vite.config.d.ts

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs and editors
/.idea
.project
.classpath
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# System files
.DS_Store
Thumbs.db
