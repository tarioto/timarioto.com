# See http://help.github.com/ignore-files/ for more about ignoring files.

# build output
/dist

# Local sample data for testing poller-fed sections. trakt.json/weather.json
# are written to the deployed S3 bucket by scheduled Lambdas; song.json/
# album.json are written by the local script in scripts/song-of-the-month/.
# None of these are built by the build script — drop sample copies here for
# local dev, never commit real ones.
/public/trakt.json
/public/weather.json
/public/song.json
/public/album.json

# dependencies
/node_modules

# TypeScript incremental build info
*.tsbuildinfo

# TypeScript-emitted tooling artifacts (from `tsc -b`)
tools/*.js
tools/*.d.ts

# OpenTofu / Terraform
**/.terraform/*
infra/.archives/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# logs
npm-debug.log*

# IDEs and editors
/.idea
.project
.classpath
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# System files
.DS_Store
Thumbs.db

# operator IAM policy (documentation, not tracked)
infra/iam-policy.json
infra/github-oidc-trust-policy.json
